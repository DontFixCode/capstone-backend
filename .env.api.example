# 현재 구현된 실행 설정 (선택 사항)
BACKEND_LOG_LEVEL=INFO

# 실행 환경(development·production)과 개발용 확인 URL(/dev/transit).
# development이고 ENABLE_DEVTOOLS=true일 때만 등록한다. 운영에서는 켜지 않는다.
BACKEND_ENV=production
ENABLE_DEVTOOLS=false

# TAGO 버스 API 호출 설정 (선택 사항, 값은 기본값)
BACKEND_TAGO_TIMEOUT_SECONDS=10
BACKEND_TAGO_REQUEST_INTERVAL_SECONDS=0.5
BACKEND_TAGO_MAX_RETRIES=2
BACKEND_TAGO_RETRY_BACKOFF_SECONDS=1

# TAGO 인증키: 복사한 .env.api에만 공공데이터포털 일반 인증키(Decoding)를 입력한다.
TAGO_SERVICE_KEY=

# 대전광역시 버스 도착정보 API(apis.data.go.kr/6300000/arrive) 인증키(Decoding). 비우면 TAGO_SERVICE_KEY를 쓴다
# (같은 공공데이터포털 계정이라도 해당 API 활용신청 승인이 필요하다). 실시간 도착정보 수집(워커·검색)과 devtools /dev/daejeon이 쓴다.
# 키가 없으면 도착정보는 수집하지 않고(위치정보 수집은 계속) 도착 대상은 실패로 기록된다.
DAEJEON_BUS_SERVICE_KEY=
BACKEND_DAEJEON_BUS_TIMEOUT_SECONDS=10

# TAGO 서비스별 승인 호출 한도(계정에서 확인한 값). 비워 두면 '미확인'으로 보고한다.
# 공개 포털의 개발 트래픽 표기를 그대로 넣지 않는다.
BACKEND_TAGO_LIMIT_STOPS=
BACKEND_TAGO_LIMIT_ROUTES=
BACKEND_TAGO_LIMIT_POSITIONS=
BACKEND_TAGO_LIMIT_ARRIVALS=

# DB 접속 위치 (DB를 쓰는 워커·CLI·/db-test에 필수). 대상 스택은 풀러 없이 SSH 터널로 DB 컨테이너에 직접 접속한다.
#   ssh -N -L 127.0.0.1:15432:<bus-transfer-supabase-db-1 IP>:5432 <계정>@<서버>
# DB 이름·비밀번호는 루트 .env의 POSTGRES_DB·POSTGRES_PASSWORD를 쓴다. 계정을 비우면 postgres.
BACKEND_DB_HOST=127.0.0.1
BACKEND_DB_PORT=15432
BACKEND_DB_USER=
BACKEND_DB_CONNECT_TIMEOUT_SECONDS=10

# 교통정보 수집 주기 (값은 기본값). 정적 정보는 하루 1회, 실시간 위치·도착정보는 대상별 600초.
BACKEND_STATIC_REFRESH_INTERVAL_SECONDS=86400
BACKEND_REALTIME_INTERVAL_SECONDS=600
# 개발 설정 실시간 수집 대상(쉼표 구분 원천 ID). 워커가 주기마다 다시 읽으므로 고치면 등록·해제된다.
BACKEND_REALTIME_POSITION_ROUTE_IDS=
BACKEND_REALTIME_ARRIVAL_STOP_IDS=
# 노선 위치·정류소 도착 화면 조회가 등록하는 수집 수요의 유효기간(초, 기본 30분). 재조회하면 연장된다.
BACKEND_REALTIME_VIEW_TARGET_TTL_SECONDS=1800
# TAGO 도착정보 잔여초의 ETA 기준 시각 정책(도착정보를 대전시 API로 바꾼 뒤에는 DB에 기준 시각이 없는 이전 TAGO 관측에만 적용). unconfirmed는 절대 ETA를 만들지 않고, server_received_at은 서버 응답 수신 시각으로
# 근사하며 결과에 기준 출처(server_received_at_approx)·정책 버전이 남는다. 2026-11-09 사용자 결정으로 검증 전에 켠다
# (Notion DB-C04 "검증한 근사 정책"과 다름, 정확도 검증은 Backend > 검증 대기 항목 1번). 코드 기본값은 unconfirmed다.
BACKEND_TAGO_ETA_BASIS_POLICY=server_received_at
# 워커가 설정을 다시 읽고 만기 작업을 확인하는 최대 대기 간격(초). 수집 주기가 아니다.
BACKEND_WORKER_POLL_SECONDS=30

# 추후 Supabase Auth 설정 (미구현, 빈 예시)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# 추후 외부 API 설정 (미구현, 빈 예시)
# PLACES_API_KEY=
# WALKING_API_KEY=

# TMAP(SK open API) 보행자 경로 앱키. 실제 값은 .env.api에만 둔다.
SK_OPEN_API_KEY=
BACKEND_TMAP_TIMEOUT_SECONDS=10

# 경로 검색·평가 실행 설정(Phase 3). 근거 있는 공통 수치가 없어 기본값이 없으며, 하나라도 비면 검색이 설정 오류로 멈춘다.
BACKEND_SEARCH_MAX_BOARDINGS=
BACKEND_SEARCH_ACCESS_RADIUS_METERS=
BACKEND_SEARCH_TRANSFER_RADIUS_METERS=
BACKEND_SEARCH_EGRESS_RADIUS_METERS=
BACKEND_SEARCH_MAX_CANDIDATES=
BACKEND_SEARCH_ROUND_POOL_SIZE=
BACKEND_SEARCH_WALK_COST_WEIGHT=
BACKEND_SEARCH_MAX_STATES=
BACKEND_SEARCH_BUDGET_MS=
BACKEND_EVAL_SEARCH_HORIZON_SECONDS=
BACKEND_EVAL_BUDGET_MS=
BACKEND_EVAL_MAX_TIMED_CANDIDATES=
BACKEND_EVAL_BOARDING_BUFFER_SECONDS=
BACKEND_EVAL_MAX_DATA_AGE_SECONDS=
BACKEND_EVAL_MIN_SEGMENT_SAMPLES=
BACKEND_EVAL_MIN_PROBABILITY_SAMPLES=
BACKEND_EVAL_MIN_JOINT_SCENES=
BACKEND_EVAL_MIN_IMPROVEMENT_SECONDS=
BACKEND_EVAL_MAX_HORIZON_DIFFERENCE_SECONDS=
BACKEND_EVAL_MAX_RECOVERY_ATTEMPTS=
BACKEND_EVAL_RECOVERY_SEARCH_ENABLED=
BACKEND_EVAL_TIMING_POLICY_VERSION=
BACKEND_EVAL_SAMPLE_POLICY_VERSION=
BACKEND_EVAL_RECOVERY_POLICY_VERSION=
BACKEND_EVAL_SEGMENT_MODEL_VERSION=
# 최초 검색 결과·실시간 대상 유효기간(초), TMAP searchOption(0 추천·4·10·30)과 검색당 최대 조회 수, 표본 판정 기한(초)
BACKEND_SEARCH_EXPIRES_SECONDS=
BACKEND_TMAP_SEARCH_OPTION=
BACKEND_TMAP_MAX_LOOKUPS_PER_SEARCH=
BACKEND_SAMPLE_LABEL_DEADLINE_SECONDS=

# ---- 앱 API·이동 세션 (Phase 4) ----
# Supabase Auth 액세스 토큰 검증. 비우면 루트 .env의 JWT_SECRET(HS256 서명 비밀값)·API_EXTERNAL_URL(issuer)을 쓴다.
# 실제 비밀값은 이 예시 파일에 넣지 않는다. audience 기본값은 GOTRUE_JWT_AUD와 같은 authenticated.
BACKEND_AUTH_JWT_SECRET=
BACKEND_AUTH_JWT_ISSUER=
BACKEND_AUTH_JWT_AUDIENCE=authenticated
# GET /stops/nearby 기본·최대 반경(m). 비우면 기본=검색 접근 반경, 최대=접근·목적지 반경 중 큰 값.
BACKEND_STOPS_NEARBY_DEFAULT_RADIUS_METERS=
BACKEND_STOPS_NEARBY_MAX_RADIUS_METERS=
# 장소 검색 제공처(프론트엔드와 확정 전). 비우면 /places/search는 503 PLACES_NOT_CONFIGURED.
BACKEND_PLACES_PROVIDER=
# 워커 앱 작업(검색 실행·이동 재평가) 대기열 확인 간격, 검색 작업 임대·최대 시도 (값은 기본값)
BACKEND_JOB_POLL_SECONDS=2
BACKEND_SEARCH_JOB_LEASE_SECONDS=180
BACKEND_SEARCH_JOB_MAX_ATTEMPTS=2
# 활성 이동 재평가 간격(1분)·계산 임대 (값은 기본값). 공유 수집 600초와 별개.
BACKEND_JOURNEY_RECALC_INTERVAL_SECONDS=60
BACKEND_JOURNEY_RECALC_LEASE_SECONDS=120
# 위치 최신성 기준(초). 비우면 BACKEND_EVAL_MAX_DATA_AGE_SECONDS. 미래 관측 시각 허용 오차(초).
BACKEND_JOURNEY_LOCATION_MAX_AGE_SECONDS=
BACKEND_LOCATION_MAX_FUTURE_SKEW_SECONDS=60
# WebSocket: DB 버전 확인 간격, 헤더 없는 연결의 첫 인증 메시지 대기 시간 (값은 기본값)
BACKEND_WS_POLL_SECONDS=2
BACKEND_WS_AUTH_TIMEOUT_SECONDS=10
# 앱 검색 지원 범위(out_of_scope) 판정용 대전광역시 행정경계 GeoJSON. 비우면 저장소 data/service_area/daejeon.geojson.
# 파일이 없거나 읽을 수 없으면 경계 없이 정류소 반경 기준만 적용하고, 확인할 수 없는 지점은 data_limited(service_area_unavailable).
BACKEND_SERVICE_AREA_GEOJSON=
